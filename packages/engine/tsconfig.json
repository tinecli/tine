{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    /* No DOM: the bundle runs in JavaScriptCore, not a browser. With DOM here,
       `window`/`document`/`HTMLElement` typecheck fine and crash at runtime.
       setTimeout, console, TextEncoder and performance come from the
       @types/node and @types/bun entries in `types` below — and so does
       `localStorage`, which biome's noRestrictedGlobals catches instead. */
    "lib": ["ES2020"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode: bun build reads the .ts sources directly, so nothing emits. */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "types": ["@withfig/autocomplete-types", "node", "bun"]
  },
  /* ../../tests holds the smoke test for this engine's bundle. It lives outside
     the package but is the only other TS in the repo, so it rides along here
     rather than earning a second tsconfig. */
  "include": ["src", "tine-engine.ts", "../../tests"]
}
