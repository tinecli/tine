{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode: bun build reads the .ts sources directly, so nothing emits. */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "types": ["@withfig/autocomplete-types", "node", "bun"]
  },
  /* ../../tests holds the smoke test for this engine's bundle. It lives outside
     the package but is the only other TS in the repo, so it rides along here
     rather than earning a second tsconfig. */
  "include": ["src", "tine-engine.ts", "../../tests"]
}
