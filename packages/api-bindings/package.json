{
  "name": "@tine/api-bindings",
  "version": "0.2.0",
  "license": "MIT OR Apache-2.0",
  "repository": "https://github.com/tinecli/tine",
  "type": "module",
  "exports": "./dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rm -rf dist/",
    "build": "npm run clean && npm run generate-requests && tsc",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "prepublishOnly": "npm run build",
    "generate-requests": "tsx codegen/generate-requests.ts && biome check --write src/requests.ts"
  },
  "dependencies": {
    "@tine/proto": "workspace:^",
    "@bufbuild/protobuf": "2.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@tine/tsconfig": "workspace:^",
    "@tsconfig/recommended": "^1.0.8",
    "@types/node": "^22.15.20",
    "@typescript/analyze-trace": "^0.10.1",
    "ts-morph": "^26.0.0",
    "tsx": "^4.19.4",
    "typescript": "^7.0.2"
  }
}
