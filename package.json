{
  "name": "tine",
  "private": true,
  "author": "Gustaf Eriksson",
  "license": "MIT OR Apache-2.0",
  "packageManager": "bun@1.3.13",
  "type": "module",
  "workspaces": [
    "proto",
    "packages/*"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "b": "turbo build",
    "test": "vitest",
    "test:ci": "vitest run --run --coverage",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "lint": "turbo lint --parallel",
    "lint:fix": "turbo lint:fix --parallel",
    "dev": "turbo dev",
    "clean": "turbo clean --parallel",
    "setup": "bash scripts/setup.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@vitest/coverage-v8": "^3.0.8",
    "@vitest/ui": "^3.0.8",
    "@withfig/autocomplete": "2.692.3",
    "esbuild": "0.25.3",
    "tsx": "^4.19.4",
    "turbo": "^2.5.2",
    "vitest": "^3.0.8"
  }
}
