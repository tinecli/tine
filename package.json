{
  "name": "tine",
  "private": true,
  "author": "Gustaf Eriksson",
  "license": "MIT OR Apache-2.0",
  "packageManager": "bun@1.3.13",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "build": "bun run --filter '*' build",
    "engine": "bash scripts/build-engine.sh",
    "test": "bun test",
    "test:ci": "bun test --coverage",
    "lint": "bun run --filter '*' lint",
    "lint:fix": "bun run --filter '*' lint:fix",
    "clean": "bun run --filter '*' clean",
    "setup": "bash scripts/setup.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/bun": "^1.3.14"
  }
}
